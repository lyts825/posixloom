{
  "version": 1,
  "runtime": {
    "workspace": "${WORKSPACE}"
  },
  "mounts": {
    "/workspace": "${runtime.workspace}",
    "/home": "$DATA/home",
    "/tmp": "$DATA/tmp",
    "/cache": "$DATA/cache",
    "/posixloom/bin": "$RUNTIME_ROOT/shims",
    "/posixloom/tools": "$RUNTIME_ROOT/native",
    "/posixloom/runtime": "$RUNTIME_ROOT"
  },
  "session": {
    "defaultStatePolicy": "cwd-env",
    "maxSessions": 1024,
    "idleTimeoutMs": 1800000
  },
  "process": {
    "defaultTimeoutMs": 30000,
    "cancelGraceMs": 2000,
    "maxOutputBytes": 8388608,
    "outputDrainTimeoutMs": 5000,
    "maxReportBytes": 1048576,
    "maxConcurrent": 8,
    "maxConcurrentPerClient": 4,
    "maxQueued": 128,
    "maxQueuedPerClient": 32,
    "queueTimeoutMs": 30000
  },
  "policy": {
    "defaultProfile": "workspace-guard",
    "profiles": {
      "trusted": {
        "mode": "trusted",
        "knownReadRoots": [],
        "knownWriteRoots": [],
        "runtimeReadOnly": false
      },
      "workspace-guard": {
        "mode": "guardrail",
        "knownReadRoots": ["/workspace", "/home", "/tmp", "/cache", "/posixloom"],
        "knownWriteRoots": ["/workspace", "/home", "/tmp", "/cache"],
        "runtimeReadOnly": true
      }
    }
  },
  "observability": {
    "traceBufferSize": 5000,
    "writeTraceFile": false,
    "collectCommandNames": false,
    "traceMaxFileBytes": 10485760,
    "traceRetainedFiles": 3,
    "traceMaxPendingBytes": 1048576,
    "traceFlushIntervalMs": 100
  },
  "protocol": {
    "maxPendingRequests": 256,
    "replayWindowSize": 10000,
    "replayWindowTtlMs": 1800000,
    "idempotencyMaxEntries": 1024,
    "idempotencyTtlMs": 1800000,
    "idempotencyMaxBytes": 33554432
  },
  "updates": {
    "enabled": true,
    "autoApply": true,
    "channel": "stable",
    "feedUrl": "",
    "checkIntervalMs": 86400000,
    "requestTimeoutMs": 10000,
    "maxDownloadBytes": 2147483648,
    "requireSignature": true,
    "trustedKeys": {}
  }
}
